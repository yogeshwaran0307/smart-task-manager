# ─── Copy this file to .env and fill in your real values ────────────────────

# Django secret key — generate a new one for production:
#   python -c "import secrets; print(secrets.token_hex(50))"
DJANGO_SECRET_KEY=django-insecure-smarttask-dev-key-change-in-production

# Set to false in production
DJANGO_DEBUG=true

# Comma-separated list of allowed hosts (use * only in dev)
DJANGO_ALLOWED_HOSTS=*

# Token auth settings
TOKEN_SECRET=smarttask-secret-key-dev-change-in-production
TOKEN_MAX_AGE_SECONDS=86400

# ─── MySQL Database (required) ───────────────────────────────────────────────
# Option A — individual variables (recommended):
DB_NAME=smart_task_manager
DB_USER=root
DB_PASSWORD=yogesh0307
DB_HOST=127.0.0.1
DB_PORT=3306

# Option B — single connection URL (alternative to Option A):
# DATABASE_URL=mysql://root:your_mysql_password@127.0.0.1:3306/smart_task_manager

# ─── Frontend CORS (leave blank in dev to allow all localhost origins) ───────
# CORS_ALLOWED_ORIGINS=https://myapp.com
